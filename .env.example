# ---- CampusShield environment variables ----
# Copy this file to ".env" for local development.

# MongoDB connection string (MongoDB Atlas recommended; REQUIRED on Vercel).
# Leave empty for LOCAL dev only: an in-memory MongoDB starts automatically and is seeded.
MONGODB_URI=

# Long random string used to sign JWT tokens (REQUIRED in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed demo data automatically when the database has no users (true/false)
AUTO_SEED=true

# Local API port (Vite dev server proxies /api to it)
PORT=5000

# Allowed origin for CORS in local dev
CLIENT_URL=http://localhost:5173
